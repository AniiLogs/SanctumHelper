<Window x:Class="SanctumHelper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SanctumHelper"
        Title="Sanctum Helper" Width="1120" Height="760" MinWidth="940" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" BorderBrush="{StaticResource Line}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,14,12,18">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Sanctum Helper'}" FontSize="15.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T 'Egg Heist companion'}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live status, always visible. -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,14" Padding="12,10" CornerRadius="8" Background="#10131C" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SideDot" Width="8" Height="8" Fill="{StaticResource Faint}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SideStatus" Text="{l:T 'Waiting for Aniimo…'}" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="SideLayout" Style="{StaticResource Hint}" Margin="16,3,0,0" FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="12,0">
                    <RadioButton x:Name="Nav_Status" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{l:T 'Status'}" IsChecked="True"/>
                    <RadioButton x:Name="Nav_Overlay" Style="{StaticResource NavItem}" Tag="&#xE890;" Content="{l:T 'Map overlay'}"/>
                    <RadioButton x:Name="Nav_Mini" Style="{StaticResource NavItem}" Tag="&#xE707;" Content="{l:T 'On-screen map'}"/>
                    <RadioButton x:Name="Nav_Markers" Style="{StaticResource NavItem}" Tag="&#xE81E;" Content="{l:T 'Markers'}"/>
                    <RadioButton x:Name="Nav_Detection" Style="{StaticResource NavItem}" Tag="&#xE721;" Content="{l:T 'Detection'}"/>
                    <RadioButton x:Name="Nav_General" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{l:T 'General'}"/>
                    <Rectangle Height="1" Fill="{StaticResource Line}" Margin="10,10"/>
                    <RadioButton x:Name="Nav_Layouts" Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="{l:T 'Layout browser'}"/>
                    <RadioButton x:Name="Nav_About" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="{l:T 'About'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T 'Minimize'}"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T 'Close (Sanctum Helper keeps running in the tray)'}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="36,0,36,6">
                <TextBlock x:Name="PageTitle" Text="{l:T 'Status'}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,4,28,28">
                <Grid MaxWidth="820" HorizontalAlignment="Left">

                    <!-- ===== Status ===== -->
                    <StackPanel x:Name="Sec_Status">
                        <UniformGrid Columns="4" Margin="0,10,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'GAME'}" Style="{StaticResource Hint}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GameValue" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="GameSub" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'EGG HEIST RUN'}" Style="{StaticResource Hint}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RunValue" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="RunSub" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'DIFFICULTY'}" Style="{StaticResource Hint}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DiffValue" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="DiffSub" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'LAYOUT'}" Style="{StaticResource Hint}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LayoutValue" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="LayoutSub" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'New run'}" Click="NewRun_Click" ToolTip="{l:T 'Forget the detected layout and start fresh'}"/>
                            <Button Content="{l:T 'Position on-screen map…'}" Click="PositionMiniMap_Click"/>
                            <Button Content="{l:T 'Open log folder'}" Click="OpenLogs_Click"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'HOW IT WORKS'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Pick a difficulty'}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'The party screen is read automatically before the run starts.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="2" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Explore the Sanctum'}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'The layout is recognized from your minimap. Opening the full map identifies it instantly.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="3" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Style="{StaticResource RowTitle}" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <Run Text="{l:T 'Hold'}"/> <Run x:Name="HowKey" Foreground="{StaticResource Accent}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'With the map open: the whole layout lined up on it. Map closed: a big map that follows you.'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="StatusDebug" Style="{StaticResource Hint}" Margin="2,8,0,0" FontSize="11.5" Foreground="{StaticResource Faint}"/>
                    </StackPanel>

                    <!-- ===== Map overlay ===== -->
                    <StackPanel x:Name="Sec_Overlay" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'HOTKEY'}" Margin="2,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Overlay key'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Click, then press a keyboard key or a middle / side mouse button. Esc cancels. The key still reaches the game.'}"/>
                                </StackPanel>
                                <Button x:Name="KeyButton" Grid.Column="1" Click="ChangeKey_Click" MinWidth="150" Padding="16,8" Margin="0" ToolTip="{l:T 'Change the overlay key'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="KeyName" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Controller button'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'A second overlay key on an Xbox-style controller. Click, then press the button (Esc cancels); right-click to clear. The button still reaches the game, so pick one you rarely need, like a stick click or View.'}"/>
                                </StackPanel>
                                <Button x:Name="PadButton" Grid.Column="1" Click="ChangePad_Click" MouseRightButtonUp="ClearPad_Click" MinWidth="150" Padding="16,8" Margin="0" ToolTip="{l:T 'Change the controller button (right-click to clear)'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PadName" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Press to toggle'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Press once to show the overlay and again to hide it, instead of holding the key.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="ToggleMode" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'ON THE FULL MAP'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Draw the whole layout'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Shows rooms that are still under fog, lined up on the in-game map.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowMapImage" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Layout opacity'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'How strongly the layout covers the game\'s map.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="MapOpacity" Minimum="0.1" Maximum="1" SmallChange="0.05" LargeChange="0.1"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=MapOpacity, StringFormat={}{0:P0}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Marker size'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Size of door, nest, key and chest icons on every map.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="MarkerScale" Minimum="0.6" Maximum="2" SmallChange="0.05" LargeChange="0.1"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=MarkerScale, StringFormat={}{0:0.00}×}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Labels'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Names under markers, such as Blue door, Nest or Gold key door.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowLabels" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Show my position'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Your arrow, tracked from the game\'s minimap, pointing the way you face.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowPlayer" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Camera view cone'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'The white wedge from your arrow showing where the camera looks, read from the game\'s minimap.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowViewCone" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== On-screen map ===== -->
                    <StackPanel x:Name="Sec_Mini" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'STYLE'}" Margin="2,10,0,8"/>
                        <ListBox x:Name="MiniMapStyles" Style="{StaticResource StyleList}" ItemContainerStyle="{StaticResource StyleCard}" Margin="0,0,-8,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,0" Text="{l:T 'Out on the island the corner map is always used; your chosen style comes back inside the Sanctum.'}"/>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'PLACEMENT'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Position'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Pick a preset, or drag the map exactly where you want it on screen.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="MiniMapCorner" MinWidth="130" Margin="0,0,8,0"/>
                                    <!-- Drag positioning: opens the placement mode (App.BeginMiniMapPlacement). -->
                                    <Button x:Name="PositionMiniMap" Content="{l:T 'Drag to position…'}" Click="PositionMiniMap_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'CAPTION'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Caption'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'A line above or below the map with the Sanctum number and difficulty (all styles but see-through).'}"/>
                                </StackPanel>
                                <ComboBox x:Name="CaptionPosition" Grid.Column="1" MinWidth="130"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Sanctum number'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Which Sanctum layout this run is, e.g. Sanctum 53.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="CaptionLayout" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Difficulty'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Normal, Hard, Nightmare or Chaos, in its own color.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="CaptionDifficulty" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'LOOK'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Size'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Width of the map panel (at 1080p; scales with your resolution).'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="MiniMapSize" Minimum="180" Maximum="520" SmallChange="10" LargeChange="20"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=MiniMapSize, StringFormat={}{0:0} px}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Zoom'}"/>
                                    <TextBlock x:Name="MiniZoomHint" Style="{StaticResource Hint}" Text="{l:T 'How much of the Sanctum fits in view. Kept separately for each style.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="MiniMapZoom" Minimum="0.25" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=MiniMapZoom, StringFormat={}{0:0.00}×}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Opacity'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Lower it to see more of the game through the map.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="MiniMapOpacity" Minimum="0.15" Maximum="1" SmallChange="0.05" LargeChange="0.1"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=MiniMapOpacity, StringFormat={}{0:P0}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'ZOOM MAP'}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,-2,0,8" Text="{l:T 'Hold the overlay key with the in-game map closed (inside the Sanctum) for a big map that follows you.'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Zoom map size'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Height of the zoom map, as a share of the screen.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="BigMapSize" Minimum="0.4" Maximum="0.95" SmallChange="0.05" LargeChange="0.05"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=BigMapSize, StringFormat={}{0:P0}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Zoom map zoom'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Higher shows more detail around you.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="BigMapZoom" Minimum="0.4" Maximum="1.6" SmallChange="0.05" LargeChange="0.1"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=BigMapZoom, StringFormat={}{0:0.00}×}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== Markers ===== -->
                    <StackPanel x:Name="Sec_Markers" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'OBJECTIVES'}" Margin="2,10,0,8"/>
                        <UniformGrid x:Name="LayerObjectives" Columns="2" Margin="0,0,-6,0"/>
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'TREASURE'}"/>
                        <UniformGrid x:Name="LayerTreasure" Columns="2" Margin="0,0,-6,0"/>
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'EVERYTHING ELSE'}"/>
                        <UniformGrid x:Name="LayerOther" Columns="2" Margin="0,0,-6,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0" Text="{l:T 'Applies to the full-map overlay, the on-screen map and the zoom map.'}"/>
                    </StackPanel>

                    <!-- ===== Detection ===== -->
                    <StackPanel x:Name="Sec_Detection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'RUN'}" Margin="2,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Difficulty'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Auto reads the party goal from the party screen before the run.'}"/>
                                </StackPanel>
                                <ComboBox x:Name="Difficulty" Grid.Column="1" MinWidth="200" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Layout'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Auto recognizes it from your minimap as you explore, or straight away from the full map\'s door icons.'}"/>
                                </StackPanel>
                                <ComboBox x:Name="ForcedLayout" Grid.Column="1" MinWidth="300" MaxWidth="340" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'TRACKING'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Track my position'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Follows you from the game\'s minimap. Needed for the on-screen and zoom maps.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="TrackMinimap" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Track me on the island'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Outside the Sanctum, show where you are on the island with its entrances and the Egg Boat.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="IslandMap" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Read the game\'s log'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Knows at once when you step out to the island, go back into the Sanctum or start a new run, from the text log the game writes (Player.log). Read-only; the game itself is never touched.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="UseGameLog" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'TROUBLESHOOTING'}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Save screenshots when matching fails'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Keeps the frames that couldn\'t be matched in the log folder, for bug reports.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="SaveDebugFrames" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== General ===== -->
                    <StackPanel x:Name="Sec_General" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'LANGUAGE'}" Margin="2,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Game language'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'The language you play Aniimo in, for reading the party screen. Auto reads it from the game\'s own settings.'}"/>
                                    <TextBlock x:Name="OcrNote" Style="{StaticResource Hint}" Foreground="#FFB060" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="GameLanguage" Grid.Column="1" MinWidth="210" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'App language'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'The language of the overlay, notices and this window. Game terms use the game\'s own wording in that language.'}"/>
                                </StackPanel>
                                <ComboBox x:Name="Language" Grid.Column="1" MinWidth="210" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'APP'}" Margin="2,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Notifications'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'A short notice in the top-right corner when the difficulty or the Sanctum is found.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowNotifications" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Start with Windows'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Starts quietly in the tray when you sign in.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="StartWithWindows" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Show in recordings and screenshots'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Lets OBS, Game Bar and screenshot tools capture the overlay.'}"/>
                                </StackPanel>
                                <CheckBox x:Name="RecordableOverlay" Grid.Column="1" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Game window title'}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:T 'Only change this if the game\'s window is named differently.'}"/>
                                </StackPanel>
                                <TextBox x:Name="WindowTitle" Grid.Column="1" Width="200" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Group}" Text="{l:T 'TIPS'}"/>
                        <Border Style="{StaticResource Card}" Background="#15181F">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="{l:T '• Play in Borderless or Windowed mode with HDR off.'}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{l:T '• Sanctum Helper only looks at screen pixels: it never reads or changes the game\'s memory or files.'}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{l:T '• Closing this window keeps the helper running in the tray. Right-click the tray icon to quit.'}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== About ===== -->
                    <StackPanel x:Name="Sec_About" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0,10,0,6" Padding="20,18">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/app.ico" Width="56" Height="56" Margin="0,0,18,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Sanctum Helper'}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="About" Style="{StaticResource Hint}" Margin="0,4,0,0" MaxWidth="560"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{l:T 'Open log folder'}" Click="OpenLogs_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ===== Layout browser (fills the page, so it lives outside the scroller) ===== -->
            <Grid x:Name="Sec_Layouts" Grid.Row="2" Margin="36,4,36,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="PreviewLayout" MinWidth="380" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                <Border Grid.Row="1" Margin="0,10,0,0" Background="#0B0D13" CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ContentControl x:Name="PreviewHost"/>
                </Border>
                <TextBlock x:Name="PreviewInfo" Grid.Row="2" Style="{StaticResource Hint}" Margin="2,8,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
